<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>HmmLearn.Tests</RootNamespace>
    <!-- xunit.v3 on Microsoft.Testing.Platform, started by `dotnet run`: no test host process and no named pipe (the agents' sandbox
         forbids them). Exit codes: 0 all passed, 2 a test failed, 8 no test ran (a filter that matches nothing is an error). -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/HmmLearn/HmmLearn.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The acceptance tests of each ticket live in tests/acceptance/<ID>/ (written by the tests agent only). -->
    <Compile Include="../acceptance/**/*.cs" />
  </ItemGroup>

</Project>
