<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>HmmLearn.Tests</RootNamespace>
    <!-- A filter that matches no test is an error (exit code 1), never a silent success. -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)/test.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/HmmLearn/HmmLearn.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The acceptance tests of each ticket live in tests/acceptance/<ID>/ (written by the tests agent only). -->
    <Compile Include="../acceptance/**/*.cs" />
  </ItemGroup>

</Project>
