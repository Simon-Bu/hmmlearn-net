{
"module": "ConvergenceMonitor",
"tolerance": {"rtol":1e-06,"atol":1e-12},
"template": "{iter:>10d} {log_prob:>16.8f} {delta:>+16.8f}",
"cases": [
  {"name":"converged-by-iterations","tol":0.001,"n_iter":2,"steps":[{"log_prob":-0.01,"converged":false,"iter":1,"history":[-0.01]},{"log_prob":-0.1,"converged":true,"iter":2,"history":[-0.01,-0.1]}],"stderr_lines":["         1      -0.01000000             +nan","         2      -0.10000000      -0.09000000"]},
  {"name":"converged-by-log-prob","tol":0.001,"n_iter":10,"steps":[{"log_prob":-0.03,"converged":false,"iter":1,"history":[-0.03]},{"log_prob":-0.02,"converged":false,"iter":2,"history":[-0.03,-0.02]},{"log_prob":-0.01,"converged":false,"iter":3,"history":[-0.03,-0.02,-0.01]},{"log_prob":-0.0101,"converged":true,"iter":4,"history":[-0.03,-0.02,-0.01,-0.0101]}],"stderr_lines":["         1      -0.03000000             +nan","         2      -0.02000000      +0.01000000","         3      -0.01000000      +0.01000000","         4      -0.01010000      -0.00010000"]},
  {"name":"decreasing-log-prob-is-converged-and-warned","tol":0.001,"n_iter":10,"steps":[{"log_prob":-0.01,"converged":false,"iter":1,"history":[-0.01]},{"log_prob":-0.02,"converged":true,"iter":2,"history":[-0.01,-0.02]},{"log_prob":-0.5,"converged":true,"iter":3,"history":[-0.01,-0.02,-0.5]}],"stderr_lines":["         1      -0.01000000             +nan","         2      -0.02000000      -0.01000000","         3      -0.50000000      -0.48000000"]},
  {"name":"never-converged","tol":1e-06,"n_iter":10,"steps":[{"log_prob":-5.0,"converged":false,"iter":1,"history":[-5.0]},{"log_prob":-4.0,"converged":false,"iter":2,"history":[-5.0,-4.0]},{"log_prob":-3.0,"converged":false,"iter":3,"history":[-5.0,-4.0,-3.0]},{"log_prob":-2.5,"converged":false,"iter":4,"history":[-5.0,-4.0,-3.0,-2.5]},{"log_prob":-2.2,"converged":false,"iter":5,"history":[-5.0,-4.0,-3.0,-2.5,-2.2]}],"stderr_lines":["         1      -5.00000000             +nan","         2      -4.00000000      +1.00000000","         3      -3.00000000      +1.00000000","         4      -2.50000000      +0.50000000","         5      -2.20000000      +0.30000000"]},
  {"name":"verbose-format","tol":0.001,"n_iter":10,"steps":[{"log_prob":-12.5,"converged":false,"iter":1,"history":[-12.5]},{"log_prob":-9.123456789,"converged":false,"iter":2,"history":[-12.5,-9.123456789]},{"log_prob":-9.1234,"converged":true,"iter":3,"history":[-12.5,-9.123456789,-9.1234]},{"log_prob":1234.5,"converged":false,"iter":4,"history":[-12.5,-9.123456789,-9.1234,1234.5]},{"log_prob":-1.2345e-05,"converged":true,"iter":5,"history":[-12.5,-9.123456789,-9.1234,1234.5,-1.2345e-05]}],"stderr_lines":["         1     -12.50000000             +nan","         2      -9.12345679      +3.37654321","         3      -9.12340000      +0.00005679","         4    1234.50000000   +1243.62340000","         5      -0.00001234   -1234.50001234"]}
]
}
